<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<!-- Project Definitions -->
    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>

        <OutputType>Library</OutputType>
        <RootNamespace>KittsCEventSystem</RootNamespace>
        <AssemblyName>KittsCEventSystem</AssemblyName>

        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>x64</Platforms>
		
		<NoWarn>1591</NoWarn>
    </PropertyGroup>

	<!-- NuGet Definitions -->
	<PropertyGroup>
		<Title>Kitts Custom Event System</Title>
		<Description>KittsCEventSystem is a framework that makes adding event easy for SCP Secret Laboratory using LabAPI.</Description>
		<Authors>Kittscloud</Authors>
		<Version>0.1.4</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>READMENUGET.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>custom-events;event-system;server-events;scripting;gameplay-mods;game-server;SCP-SL;plugin;server-customization;triggers;game-events;modding;automation;event-handling;extensions;plugin-framework</PackageTags>
		<RepositoryUrl>https://github.com/Kittscloud/KittsCEventSystem</RepositoryUrl>
		<Copyright>Copyright © Kittscloud 2026</Copyright>
	</PropertyGroup>

	<ItemGroup>
	    <None Include="..\LICENSE"> <Pack>True</Pack><PackagePath>\</PackagePath> </None>
		<None Include="..\READMENUGET.md"> <Pack>True</Pack><PackagePath>\</PackagePath> </None>
		<None Include="..\README.md"> <Pack>True</Pack><PackagePath>\</PackagePath> </None>
		<None Include="..\CHANGELOG.md"> <Pack>True</Pack><PackagePath>\</PackagePath> </None>
	</ItemGroup>

    <!-- Release | x64 -->
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>
	
	<!-- NuGet Packages -->
    <ItemGroup>
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
		<PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
		<PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    </ItemGroup>
	
	<!-- References -->
	<ItemGroup>
		<Reference Include="Assembly-CSharp-firstpass" HintPath="..\..\$Resources\Local Admin Server\SCPSL_Data\Managed\Assembly-CSharp-firstpass.dll" />
		<Reference Include="Assembly-CSharp" HintPath="..\..\$Resources\Local Admin Server\SCPSL_Data\Managed\Assembly-CSharp.dll" Publicize="true" />
		<Reference Include="CommandSystem.Core" HintPath="..\..\$Resources\Local Admin Server\SCPSL_Data\Managed\CommandSystem.Core.dll" />
		<Reference Include="Mirror" HintPath="..\..\$Resources\Local Admin Server\SCPSL_Data\Managed\Mirror.dll" />
		<Reference Include="UnityEngine.CoreModule" HintPath="..\..\$Resources\Local Admin Server\SCPSL_Data\Managed\UnityEngine.CoreModule.dll" />
	</ItemGroup>
</Project>
